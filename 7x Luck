lua
-- 7X LUCK GUI
-- Display toggle only

local Players = game:GetService("Players")
local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- Remove old GUI
local oldGui = playerGui:FindFirstChild("7X LUCK")
if oldGui then
    oldGui:Destroy()
end

-- Main GUI
local gui = Instance.new("ScreenGui")
gui.Name = "7X LUCK"
gui.ResetOnSpawn = false
gui.Parent = playerGui

-- Main Frame
local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 270, 0, 160)
frame.Position = UDim2.new(0.5, -135, 0.5, -80)
frame.BackgroundColor3 = Color3.fromRGB(18, 15, 27)
frame.BorderSizePixel = 0
frame.Active = true
frame.Draggable = true
frame.Parent = gui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 14)
corner.Parent = frame

local stroke = Instance.new("UIStroke")
stroke.Color = Color3.fromRGB(160, 70, 255)
stroke.Thickness = 2
stroke.Parent = frame

-- Title
local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 65)
title.BackgroundTransparency = 1
title.Text = "✦ 7X LUCK ✦"
title.TextColor3 = Color3.fromRGB(205, 160, 255)
title.Font = Enum.Font.GothamBold
title.TextSize = 24
title.Parent = frame

-- Toggle Button
local toggle = Instance.new("TextButton")
toggle.Size = UDim2.new(1, -70, 0, 40)
toggle.Position = UDim2.new(0, 35, 0, 90)
toggle.BackgroundColor3 = Color3.fromRGB(210, 45, 55)
toggle.Text = "7X LUCK : OFF"
toggle.TextColor3 = Color3.fromRGB(255, 255, 255)
toggle.Font = Enum.Font.GothamBold
toggle.TextSize = 18
toggle.Parent = frame

local buttonCorner = Instance.new("UICorner")
buttonCorner.CornerRadius = UDim.new(0, 9)
buttonCorner.Parent = toggle

local enabled = false

toggle.Activated:Connect(function()
    enabled = not enabled

    if enabled then
        toggle.Text = "7X LUCK : ON"
        toggle.BackgroundColor3 = Color3.fromRGB(35, 190, 90)
    else
        toggle.Text = "7X LUCK : OFF"
        toggle.BackgroundColor3 = Color3.fromRGB(210, 45, 55)
    end
end)

print("7X LUCK GUI Loaded!")
